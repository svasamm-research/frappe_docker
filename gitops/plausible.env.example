# Plausible Analytics Configuration
# Copy to plausible.env and fill in values

# Required: Base URL where Plausible will be accessible
BASE_URL=https://analytics.lucoze.com

# Required: Secret key for session encryption (generate with: openssl rand -base64 48)
SECRET_KEY_BASE=

# Database connection (matches plausible-db service)
DATABASE_URL=postgres://postgres:postgres@plausible-db:5432/plausible_db

# ClickHouse connection (matches plausible-events-db service)
CLICKHOUSE_DATABASE_URL=http://plausible-events-db:8123/plausible_events_db

# Disable registration after first admin user is created
DISABLE_REGISTRATION=invite_only

# SMTP for email reports (optional)
# SMTP_HOST_ADDR=
# SMTP_HOST_PORT=587
# SMTP_USER_NAME=
# SMTP_USER_PWD=
# SMTP_HOST_SSL_ENABLED=true
# MAILER_EMAIL=analytics@lucoze.com
