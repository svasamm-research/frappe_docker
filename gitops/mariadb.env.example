# MariaDB shared instance environment file
# =========================================
# Copy this to ~/gitops/mariadb.env on the server (never commit the real file).
# Deploy using: compose.mariadb-shared.yaml in Dokploy.
#
# This single MariaDB instance is shared across ALL benches on this server.
# Each bench's DB_PASSWORD must match this value.

DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
