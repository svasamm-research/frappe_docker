# CA Firm bench environment file
# ================================
# Copy to ~/gitops/cafirm.env on the server (never commit the real file).
#
# Generate the final compose yaml on your LOCAL machine:
#
#   docker compose \
#     --env-file gitops/cafirm.env \
#     -f compose.yaml \
#     -f overrides/compose.redis.yaml \
#     -f overrides/compose.dokploy.yaml \
#     -f overrides/compose.dokploy-ssl.yaml \
#     config > ~/gitops/cafirm.yaml
#
# Then upload ~/gitops/cafirm.yaml to the server or paste it into Dokploy UI.
# ---------------------------------------------------------------------------

# --- Image -------------------------------------------------------------------
# Docker Hub image built by GitHub Actions (svasamm/frappe-cafirm)
CUSTOM_IMAGE=svasamm/frappe-cafirm

# Pin to a specific SHA tag for stable production deployments:
#   version-16-abc1234  (output of build-cafirm.yml, shown in workflow summary)
# Use version-16 to always pull latest:
CUSTOM_TAG=version-16

# always  = pull on every container start (use for version-16 mutable tag)
# missing = only pull if image not present locally (use for pinned SHA tags)
PULL_POLICY=always

# --- Database ----------------------------------------------------------------
# Must match DB_PASSWORD in mariadb.env
DB_HOST=mariadb-database
DB_PORT=3306
DB_PASSWORD=CHANGE_ME_SAME_AS_MARIADB_ENV

# --- Traefik routing ---------------------------------------------------------
# ROUTER: unique name for this bench's Traefik router and bench-network.
# Must be unique per bench on this server.
ROUTER=cafirm

# SITES_RULE: all domains this bench serves.
# Add each new client site here and regenerate cafirm.yaml.
# Example with two client sites:
#   SITES_RULE=Host(`ca-firm-a.yourdomain.com`) || Host(`ca-firm-b.yourdomain.com`)
SITES_RULE=Host(`CHANGE_ME.yourdomain.com`)

# --- SSL / Let's Encrypt -----------------------------------------------------
LETSENCRYPT_EMAIL=mithun@svasamm.com
